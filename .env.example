# ============================================================
# NER Landslide Early Warning & Response System
# Environment Configuration
# ============================================================

# Operating Mode: LIVE | DEMO
VITE_OPERATING_MODE=DEMO

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001/ws

# Map Configuration
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_CENTER_LAT=25.5
VITE_MAP_CENTER_LNG=93.0
VITE_MAP_ZOOM=7

# Feature Flags
VITE_ENABLE_SIMULATION=true
VITE_ENABLE_FIELD_AI=true
VITE_ENABLE_OFFLINE=true

# External Services (Backend will use these)
# IMD_API_KEY=
# ISRO_BHUVAN_KEY=
# GSI_API_KEY=
# SMS_PROVIDER_KEY=
# PUSH_NOTIFICATION_KEY=
